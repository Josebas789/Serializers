# ============================================
# PYTHON / DJANGO
# ============================================

# Entornos virtuales
venv/
env/
.venv/
Env/
ENV/

# Archivos Python compilados
__pycache__/
*.py[cod]
*$py.class

# Archivos de logs / debugging
*.log

# Base de datos SQLite
db.sqlite3
db.sqlite3-journal

# Archivos de migración (opcional)
# Si NO quieres subir las migraciones al repo, descomenta:
# **/migrations/
# Pero mantenemos __init__.py:
# !**/migrations/__init__.py

# Configuración sensible
*.env
.env.*
.env.local
.env.backup

# Caché de Django
*.pot
*.pyproj
staticfiles/
media/
static/

